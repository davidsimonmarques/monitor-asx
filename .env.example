# Configuração do Bot do Telegram
# Crie seu bot no @BotFather e pegue o token
TELEGRAM_BOT_TOKEN=seu_bot_token_aqui

# Obtenha seu chat id com @userinfobot ou enviando mensagem para seu bot e checando https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=seu_chat_id_aqui

# Opcional: modo de execução (True/False)
# DRY_RUN=True simula o envio de mensagens sem disparar no Telegram
DRY_RUN=False

# Limite máximo de preço principal (padrão R$ 70.000,00)
MAX_PRICE=70000

# Limite máximo para contraproposta (padrão R$ 80.000,00)
COUNTEROFFER_MAX_PRICE=80000

# Ano mínimo (padrão 2014)
MIN_YEAR=2014
